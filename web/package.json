{
  "name": "nyayaai",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "test": "npm run test --workspace server",
    "lint": "npm run lint --workspace server && npm run lint --workspace client",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "ingest": "npm run ingest --workspace server",
    "ingest:constitution": "npm run ingest:constitution --workspace server",
    "ingest:acts": "npm run ingest:acts --workspace server",
    "ingest:judgments": "npm run ingest:judgments --workspace server",
    "ingest:documents": "npm run ingest:documents --workspace server"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
